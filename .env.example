# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string (Prisma Data Proxy or your own DB)
# Required: add this variable in your deployment environment variables (Render, GitHub Actions, etc.)
DATABASE_URL="your_database_url_here"

# ============================================
# CLERK (Authentication)
# ============================================
# Get these from https://dashboard.clerk.com/api-keys
#
# HOW ENVIRONMENT KEYS WORK:
#   - .env.local contains YOUR local keys (gitignored, never committed)
#   - .env.example contains sample keys for reference only
#   - Your deployment platform reads keys from its environment variables settings

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_secret_key_here"
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"







# ============================================
# CLOUDINARY (Media Storage)
# ============================================
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name_here"
CLOUDINARY_API_KEY="your_cloudinary_api_key_here"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# ============================================
# UPSTASH REDIS (Caching)
# ============================================
# Get these from https://console.upstash.io/
UPSTASH_REDIS_REST_URL="https://your_redis_instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_redis_token_here"

# ============================================
# OPENROUTER (AI Chat)
# ============================================
# Get API key from https://openrouter.ai/keys
#OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"

# ============================================
# BREVO (Email Delivery)
# ============================================
# Get API key from https://www.brevo.com/account/api-keys
# Free plan: 300 emails/day, no custom domain required
# Sender email must be verified in Brevo dashboard → Transactional → Senders
BREVO_API_KEY="xkeysib-your_brevo_api_key_here"

EMAIL_FROM="your_email@example.com"
EMAIL_FROM_NAME="Your App Name Here"
EMAIL_REPLY_TO="your_email@example.com"

# ============================================
# APP CONFIGURATION
# ============================================
# Your app's public URL (used for AI chat headers)
NEXT_PUBLIC_SITE_URL="https://your-app-url.example.com"
