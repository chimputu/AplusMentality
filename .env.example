# ============================================
# CLERK (Authentication)
# ============================================
# Get these from https://dashboard.clerk.com/api-keys
#
# HOW ENVIRONMENT KEYS WORK:
#   - .env.local contains YOUR local keys (gitignored, never committed)
#   - .env.example contains sample keys for reference only
#   - Vercel reads keys from Dashboard → Settings → Environment Variables
#
# For local development, create .env.local with:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...  (test keys)
#   CLERK_SECRET_KEY=sk_test_...                    (test keys)
#   CLERK_WEBHOOK_SECRET=whsec_...                  (webhook secret)
#
# For Vercel production, set these in the dashboard:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...   (live keys)
#   CLERK_SECRET_KEY=sk_live_...                    (live keys)
#   CLERK_WEBHOOK_SECRET=whsec_...                  (webhook secret)
#
# Clerk's proxy.ts middleware auto-detects the environment from the publishable key:
#   - pk_test_ → development mode (uses *.clerk.accounts.dev)
#   - pk_live_ → production mode (auto-proxies via /__clerk on *.vercel.app)

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key_here"

CLERK_SECRET_KEY="your_clerk_secret_key_here"

# Webhook secret for syncing Clerk events to your database
# Get from https://dashboard.clerk.com/webhooks
CLERK_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

