// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"


}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================
enum Role {
  ADMIN
  SUPER_ADMIN
  STUDENT
  LECTURER
  TUTOR
}

enum FormType {
  QUIZ
  TEST
  ASSIGNMENT
}

enum SubmissionStatus {
  PENDING
  GRADED
  RETURNED
}

enum PendingUploadStatus {
  UNTAGGED
  TAGGED
  ARCHIVED
}

enum AcademicSystem {
  YEARLY
  SEMESTERLY
  TRIMESTERLY
}

// ============================================
// INSTITUTION ENUMS
// ============================================
enum InstitutionType {
  UNIVERSITY
  COLLEGE
  POLYTECHNIC
  INSTITUTE
  MEDICAL_SCHOOL
  BUSINESS_SCHOOL
  TECHNICAL_COLLEGE
  VOCATIONAL_SCHOOL
}

enum LevelType {
  YEAR
  STAGE
  PHASE
  GRADE
}

enum PeriodType {
  SEMESTER
  TERM
  TRIMESTER
  QUARTER
  BLOCK
}

// ============================================
// ASSESSMENT ENGINE ENUMS
// ============================================
enum AssessmentType {
  QUIZ
  TEST
  EXAM
  ASSIGNMENT
  PRACTICE
}

enum AssessmentMode {
  GOOGLE_FORM
  NATIVE
}

enum LiveStatus {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  IMAGE_CHOICE
  FILE_UPLOAD
  FILL_IN_BLANK
  MATCHING
  NUMERIC
}

enum ResultReveal {
  IMMEDIATELY
  AFTER_CLOSE
  AFTER_MANUAL
  NEVER
}

// ============================================
// ASSESSMENT ENGINE EXTENSION ENUMS
// ============================================
enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  ABANDONED
}

enum AssessmentSource {
  NATIVE
  GOOGLE_FORM
  MICROSOFT_FORM
  EXTERNAL_LINK
}

// ============================================
// BANNER ENUMS
// ============================================
enum BannerVariant {
  INFO
  SUCCESS
  WARNING
  DANGER
  PROMO
}

enum BannerPlacement {
  HOMEPAGE
  DASHBOARD
  BOTH
}

enum BannerScope {
  GLOBAL
  ALL
  SPECIFIC
}

// ============================================
// USERS
// ============================================
model User {
  id             String         @id @default(cuid())
  clerkId        String         @unique
  email          String         @unique
  username       String?        @unique
  firstName      String?
  lastName       String?
  name           String?
  imageUrl       String?
  role           Role           @default(STUDENT)
  isVerifiedTutor Boolean       @default(false)
  theme          String?        @default("system")

  // Student academic profile
  universityId  String?
  university    University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  programmeId   String?
  programme     Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  branchId      String?
  branch        Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  year          Int?
  period        String?  // "1", "2", "3" for semester/trimester; "" for yearly
  onboarded     Boolean  @default(false)

  // Relations
  announcements  Announcement[]
  videos         Video[]
  courses        Course[]
  enrollments    Enrollment[]
  lectureSlides  LectureSlide[]
  quizzes        Quiz[]
  tests          Test[]
  assignments    Assignment[]
  quizSubmissions QuizSubmission[]
  testSubmissions TestSubmission[]
  assignmentSubmissions AssignmentSubmission[]
  lessonCompletions LessonCompletion[]
  pastPapers     PastPaper[]
  notifications  Notification[]
  notificationSeens NotificationSeen[]
  savedBooks     SavedBook[]

  // Assessment engine relations
  assessments        Assessment[]        @relation("AssessmentCreator")
  assessmentAttempts AssessmentAttempt[]
  formResponses      FormResponse[]

  // Chat persistence relations
  chatConversations  ChatConversation[]

  // Tutor relations
  tutorProfile       Tutor?
  tutorRequests      TutorRequest[]
  tutorApplication   TutorApplication?

  // Institution change requests
  institutionChangeRequests InstitutionChangeRequest[]

  // Clerk Organization relations
  clerkOrgId                 String?
  clerkOrgRole               String?
  organizationMemberships    OrganizationMembership[]

  // Exploration tracking
  explorationLogs            ExplorationLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([role])
  @@index([email])
  // Perf: composite index speeds up admin user listing filtered by institution + role
  @@index([institutionId, role])
  @@index([clerkOrgId])
}

// ============================================
// ANNOUNCEMENTS
// ============================================
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [clerkId])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([authorId])
}

// ============================================
// VIDEOS
// ============================================
model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  cloudinaryId String?
  url          String
  thumbnail    String?
  source       String?
  youtubeId    String?
  uploadedBy   String
  uploader     User     @relation(fields: [uploadedBy], references: [clerkId])
  lessons      Lesson[]

  // ⭐ NEW — scoping to a course
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  order    Int?

  isPreview   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([uploadedBy])
  @@index([source])
  @@index([courseId])
  @@index([courseId, isPreview])
}

// ============================================
// COURSE STRUCTURE
// ============================================

model Course {
  id          String   @id @default(cuid())
  code        String
  title       String
  description String?
  thumbnail   String?
  category    String?
  level       String?

  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  programmeId String?
  programme   Programme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  // NEW: link to AcademicLevel for programme→year→course hierarchy
  levelId     String?
  academicLevel AcademicLevel? @relation(fields: [levelId], references: [id], onDelete: SetNull)

  // NEW: link to AcademicPeriod
  periodId    String?
  academicPeriod AcademicPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  // NEW: explicit year number for display (1-10)
  yearNumber  Int?

  year        Int?
  period      String?  // "1", "2", "3" for semester/trimester; "" for yearly

  modules     Module[]
  enrollments Enrollment[]
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [clerkId])

  lectureSlides    LectureSlide[]
  pendingUploads   PendingUpload[]
  videos           Video[]
  pastPapers       PastPaper[]
  quizzes          Quiz[]
  tests            Test[]
  assignments      Assignment[]
  tutorialSheets   TutorialSheet[]
  assessments      Assessment[]
  tutorSpecialties TutorSpecialty[]

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutorOfferings TutorOffering[]

  @@unique([universityId, programmeId, year, period, code])
  @@index([isPublished])
  @@index([createdAt])
  @@index([createdBy])
  @@index([universityId])
  @@index([programmeId])
  @@index([programmeId, yearNumber])
  @@index([levelId])
  @@index([periodId])
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)

  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  @@index([order])
  @@index([courseId, order])
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)

  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  videoId     String?
  video       Video?   @relation(fields: [videoId], references: [id])
  slidesId    String?
  slides      LectureSlide? @relation(fields: [slidesId], references: [id])
  quizId      String?
  quiz        Quiz?    @relation(fields: [quizId], references: [id])

  completions LessonCompletion[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([moduleId])
  @@index([order])
  @@index([moduleId, order])
}

// ============================================
// LECTURE SLIDES
// ============================================
model LectureSlide {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String?
  fileUrl     String?
  contentType String?
  order       Int      @default(0)
  category    String?
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [clerkId])
  lessons     Lesson[]
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId])
  // Perf: composite index for ordered slide lookups within a course
  @@index([courseId, order])
  @@index([courseId, isPreview])
  @@index([category])
  @@index([createdAt])
  @@index([createdBy])
}

// ============================================
// QUIZZES
// ============================================
model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String
  formUrl     String
  dueDate     DateTime?
  fileUrl     String?
  contentType String?

  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [clerkId])
  lessons     Lesson[]
  submissions QuizSubmission[]

  // ⭐ NEW — scoping to a course
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  isPublished Boolean  @default(true)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([isPublished])
  @@index([courseId])
  @@index([courseId, isPreview])
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId])

  score       Int?
  total       Int?
  feedback    String?

  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime @default(now())
  gradedAt    DateTime?
  gradedBy    String?

  responseId  String?

  @@index([userId])
  @@index([quizId])
}

// ============================================
// TESTS
// ============================================
model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String
  formUrl     String
  dueDate     DateTime?
  maxScore    Int?
  fileUrl     String?
  contentType String?

  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [clerkId])
  submissions TestSubmission[]

  // ⭐ NEW — scoping to a course
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  isPublished Boolean  @default(true)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([isPublished])
  @@index([courseId])
  @@index([courseId, isPreview])
}

model TestSubmission {
  id          String   @id @default(cuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId])

  score       Int?
  total       Int?
  feedback    String?

  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime @default(now())
  gradedAt    DateTime?
  gradedBy    String?

  responseId  String?

  @@index([userId])
  @@index([testId])
}

// ============================================
// ASSIGNMENTS
// ============================================
model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String
  formUrl     String
  dueDate     DateTime?
  maxScore    Int?
  fileUrl     String?
  contentType String?

  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [clerkId])
  submissions AssignmentSubmission[]

  // ⭐ NEW — scoping to a course
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  isPublished Boolean  @default(true)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
  @@index([isPublished])
  @@index([courseId])
  @@index([courseId, isPreview])
  // Perf: composite index for assignment listing sorted by due date within a course
  @@index([courseId, dueDate])
}

model AssignmentSubmission {
  id          String   @id @default(cuid())
  assignmentId String
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId])

  score       Int?
  total       Int?
  feedback    String?

  status      SubmissionStatus @default(PENDING)
  submittedAt DateTime @default(now())
  gradedAt    DateTime?
  gradedBy    String?

  responseId  String?
  fileUrl     String?

  @@index([userId])
  @@index([assignmentId])
}

// ============================================
// ENROLLMENT
// ============================================
model Enrollment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId])

  progress    Int      @default(0)
  enrolledAt  DateTime @default(now())

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
  @@index([enrolledAt])
}

// ============================================
// LESSON COMPLETIONS
// ============================================
model LessonCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ============================================
// PAST PAPERS
// ============================================
model PastPaper {
  id          String   @id @default(cuid())
  title       String
  description String?
  courseCode  String?
  year        Int?
  semester    String?
  category    String   @default("final_exam")
  fileUrl     String
  fileType    String?
  fileSize    Int?
  createdBy   String
  creator     User     @relation(fields: [createdBy], references: [clerkId])

  // ⭐ NEW — scoping to a course
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseCode])
  @@index([year])
  @@index([category])
  @@index([createdAt])
  @@index([courseId])
  @@index([courseId, isPreview])
}

// ============================================
// NOTIFICATION
// ============================================
model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  type        String
  title       String
  description String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  seen        NotificationSeen[]

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

// ============================================
// NOTIFICATION SEEN (per-user read tracking)
// ============================================
model NotificationSeen {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  notificationId  String
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  seenAt          DateTime @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
  @@index([notificationId])
}

// ============================================
// BOOKS (free educational + public-domain)
// ============================================
model Book {
  id              String   @id @default(cuid())
  source          String   // 'gutenberg' | 'openlibrary'
  sourceId        String   // external ID
  title           String
  authors         String
  coverUrl        String?
  publishYear     Int?
  description     String?
  subjects        String?
  language        String?
  readUrl         String?  // online reader
  downloadPdfUrl  String?  // legal PDF download
  downloadEpubUrl String?  // legal EPUB download

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savedBy         SavedBook[]

  @@unique([source, sourceId])
  @@index([title])
  @@index([authors])
  @@index([source])
  @@index([createdAt])
}

// ============================================
// SAVED BOOKS (student library)
// ============================================
model SavedBook {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([savedAt])
}

// ============================================
// UNIVERSITY & PROGRAMME
// ============================================
model University {
  id              String         @id @default(cuid())
  name            String
  code            String         @unique  // e.g. "MU", "UNZA", "CBU"
  joinSlug        String?        @unique  // e.g. "unza-2024" for magic join links
  academicSystem  AcademicSystem @default(SEMESTERLY)
  courses         Course[]
  programmes      Programme[]
  tutors          Tutor[]
  users           User[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([academicSystem])
}

model Programme {
  id              String    @id @default(cuid())
  name            String    // e.g. "BSc Natural Sciences"
  shortName       String?   // e.g. "BSc NS"
  code            String?   // e.g. "BSC-CS", "DIP-ACC"

  // Legacy: University link
  universityId    String?
  university      University? @relation(fields: [universityId], references: [id], onDelete: SetNull)

  // New: Institution link
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  // Faculty link
  facultyId       String?
  faculty         Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  courses         Course[]
  branches        Branch[]
  tutors          Tutor[]
  users           User[]
  changeRequests  InstitutionChangeRequest[] @relation("ChangeRequestNewProg")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([institutionId, code])
  @@index([universityId])
  @@index([institutionId])
  @@index([facultyId])
}

model Branch {
  id          String    @id @default(cuid())
  name        String
  programmeId String
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  tutors      Tutor[]
  users       User[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([programmeId, name])
  @@index([programmeId])
}

// ============================================
// PENDING UPLOADS (staging area)
// ============================================
model PendingUpload {
  id             String              @id @default(cuid())
  filename       String
  originalName   String
  url            String
  fileType       String
  mimeType       String
  fileSize       Int

  suggestedCode  String?  // auto-extracted from filename via regex

  status         PendingUploadStatus @default(UNTAGGED)

  courseId       String?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  contentType    String?  // "lecture_slide" | "video" | "past_paper" | "quiz" | "test" | "assignment" | "tutorial"
  order          Int?

  uploadedBy     String
  createdAt      DateTime           @default(now())
  taggedAt       DateTime?

  @@index([status])
  @@index([uploadedBy])
  @@index([createdAt])
}

// ============================================
// TUTORIAL SHEETS
// ============================================
model TutorialSheet {
  id        String   @id @default(cuid())
  title     String
  url       String
  number    Int
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isPreview   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([courseId, number])
  @@index([courseId, isPreview])
}

// ============================================
// ASSESSMENT ENGINE
// ============================================
model Assessment {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        AssessmentType
  mode        AssessmentMode
  liveStatus  LiveStatus     @default(DRAFT)
  courseId    String
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // GOOGLE_FORM fields
  embedUrl    String?
  formUrl     String?
  fileUrl     String?
  contentType String?

  // NATIVE fields
  timeLimit   Int?
  openAt      DateTime?
  closeAt     DateTime?
  maxGrade    Int @default(100)
  passingScore Int @default(50)
  attemptsMax Int     @default(1)
  attemptCooldownHrs Int @default(0)
  keepBestScore Boolean @default(true)
  shuffleQs   Boolean      @default(false)
  showAnswersAfter ResultReveal @default(IMMEDIATELY)
  resultsReleasedAt DateTime?
  proctored   Boolean @default(false)
  maxTabSwitches Int     @default(3)
  requireFullscreen Boolean @default(false)
  disableCopyPaste Boolean @default(true)
  requireCamera Boolean @default(false)

  dueDate     DateTime?
  isPublished Boolean @default(false)

  createdBy String
  creator   User     @relation("AssessmentCreator", fields: [createdBy], references: [clerkId])

  questions     Question[]
  attempts      AssessmentAttempt[]
  formResponses FormResponse[]
  overrides     AttemptOverride[]
  items         AssessmentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, type, mode, isPublished])
}

model Question {
  id           String       @id @default(cuid())
  assessmentId String?
  assessment   Assessment?  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  order        Int          @default(0)
  type         QuestionType
  prompt       String
  imageUrl     String?
  options      Json?
  correctId    String?
  correctText  String?
  points       Int          @default(1)
  explanation  String?

  // Extended fields for question bank
  courseId     String?
  difficulty   Int          @default(1)
  tags         Json?
  acceptedAnswers Json?
  correctNumber Float?
  tolerance    Float?
  matchingPairs Json?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Extension relations
  questionOptions QuestionOption[]
  assessmentItems AssessmentItem[]
  answers         Answer[]

  @@index([assessmentId, order])
  @@index([courseId])
  @@index([type])
  @@index([difficulty])
}

model AssessmentAttempt {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  attemptNumber Int     @default(1)
  isBest        Boolean @default(false)
  previousId    String?
  answers       Json?
  fileUrl       String?
  fileName      String?
  startedAt     DateTime  @default(now())
  submittedAt   DateTime?
  timeSpent     Int?
  score         Int?
  totalPoints   Int?
  percentage    Int?
  passed        Boolean?
  gradedAt      DateTime?
  gradedBy      String?
  feedback      String?
  tabSwitches   Int     @default(0)
  fullscreenExits Int @default(0)
  copyAttempts  Int     @default(0)
  violations    Json?
  autoSubmitted Boolean @default(false)
  resultViewedAt DateTime?

  // Extension relations
  normalizedAnswers Answer[]

  @@index([assessmentId, userId, attemptNumber])
}

model FormResponse {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  responseId   String?
  score        Int?
  total        Int?
  feedback     String?
  status       String       @default("PENDING")
  submittedAt  DateTime     @default(now())
  gradedAt     DateTime?
  gradedBy     String?

  @@index([assessmentId, userId])
}

model AttemptOverride {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId        String
  extraAttempts Int        @default(0)
  waiveCooldown Boolean    @default(false)
  reason        String?
  grantedBy     String
  createdAt     DateTime   @default(now())

  @@unique([assessmentId, userId])
}

// ============================================
// CHAT PERSISTENCE
// ============================================
model ChatConversation {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String           @default("New conversation")
  mode          String           // 'PUBLIC' | 'LOGGED_IN' — snapshot at creation
  isArchived    Boolean          @default(false)

  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  messages      ChatMessage[]

  @@index([userId, lastMessageAt])
  @@index([userId, isArchived])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role           String           // 'user' | 'assistant'
  content        String           @db.Text
  isError        Boolean          @default(false)
  tokensUsed     Int?             // optional — if you track
  metadata       Json?            // model, latency, etc.

  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// ============================================
// ASSESSMENT ENGINE EXTENSIONS
// ============================================

// Normalized question options (replaces JSON storage for new questions)
model QuestionOption {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text        String   @db.Text
  isCorrect   Boolean  @default(false)
  order       Int
  @@index([questionId])
}

// Junction table for Assessment ↔ Question with ordering
model AssessmentItem {
  id             String     @id @default(cuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  order          Int
  pointsOverride Int?
  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

// Normalized answers (replaces JSON in AssessmentAttempt)
model Answer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptionId String?
  textAnswer       String?     @db.Text
  numericAnswer    Float?
  matchingAnswer   Json?

  isCorrect        Boolean?
  pointsEarned     Float?
  feedback         String?     @db.Text

  answeredAt       DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ============================================
// TUTOR SYSTEM
// ============================================
model Tutor {
  id              String     @id @default(cuid())
  userId          String?    @unique
  user            User?      @relation(fields: [userId], references: [id])
  fullName        String
  email           String     @unique
  phone           String?
  bio                    String?
  avatarUrl              String?
  profileImagePublicId   String?
  universityId           String?
  university      University? @relation(fields: [universityId], references: [id])
  programmeId     String?
  programme       Programme?  @relation(fields: [programmeId], references: [id])
  branchId        String?
  branch          Branch?     @relation(fields: [branchId], references: [id])
  yearsExperience Int        @default(0)
  availability    String?
  mode            String     @default("online")
  contactVia      String     @default("form")
  isVerified      Boolean    @default(false)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  specialties     TutorSpecialty[]
  requests        TutorRequest[]

  @@index([universityId, isActive])
  @@index([isVerified, isActive])
}

model TutorSpecialty {
  id              String    @id @default(cuid())
  tutorId         String
  tutor           Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personalEnabled Boolean   @default(true)
  personalRate    Decimal?  @db.Decimal(10, 2)
  groupEnabled    Boolean   @default(false)
  groupRate       Decimal?  @db.Decimal(10, 2)
  groupMinSize    Int?
  groupMaxSize    Int?
  currency        String    @default("ZMW")
  notes           String?

  @@unique([tutorId, courseId])
  @@index([courseId])
}

model TutorRequest {
  id            String    @id @default(cuid())
  tutorId       String
  tutor         Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentId     String?
  student       User?     @relation(fields: [studentId], references: [id])
  studentName   String
  studentEmail  String
  studentPhone  String?
  courseId      String?
  courseNeeded  String?
  sessionType   String    @default("PERSONAL")
  quotedRate    Decimal?  @db.Decimal(10, 2)
  currency      String    @default("ZMW")
  preferredAt   String?
  message       String
  status        String    @default("PENDING")
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tutorId, status])
  @@index([createdAt])
  @@index([sessionType])
}

// ============================================
// TUTOR APPLICATION (Self-service tutor application)
// ============================================
enum TutorApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

model TutorApplication {
  id              String                 @id @default(cuid())
  userId          String                 @unique
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId   String?
  institution     Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  fullName        String
  email           String
  phone           String?
  qualifications  Json?                  // Array of {degree, institution, year}
  experienceYears Int                    @default(0)
  cvUrl           String?
  cvPublicId      String?
  teachingPhilosophy String?             @db.Text
  status          TutorApplicationStatus @default(PENDING)
  adminNotes      String?                @db.Text
  rejectionReason String?                @db.Text
  submittedAt     DateTime               @default(now())
  reviewedAt      DateTime?
  decidedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // ─── IDENTITY VERIFICATION ───
  profilePhotoUrl         String?
  profilePhotoPublicId    String?
  nrcFrontUrl             String?
  nrcFrontPublicId        String?
  nrcBackUrl              String?
  nrcBackPublicId         String?
  nrcNumber               String?

  // ─── GRADE 12 RESULTS ───
  grade12School           String?
  grade12Year             Int?
  grade12ResultsUrl       String?
  grade12Summary          String?  @db.Text

  // ─── CURRENT ACADEMIC RECORDS ───
  currentInstitution      String?
  currentProgramme        String?
  currentYear             Int?
  academicRecordsUrl      String?
  academicSummary         String?  @db.Text

  // ─── TEACHING MODES ───
  teachingModes           String[] // ['ONLINE', 'HYBRID', 'PHYSICAL']
  physicalLocation        String?

  // ─── TEACHING SCHEDULE ───
  teachingSchedule        Json?

  // ─── PRICING ───
  hourlyRateZMW           Int?
  minimumBookingHours     Int?

  // ─── ADMIN CONTROL ───
  isReadyToTeach          Boolean  @default(false)

  // ─── RELATIONS ───
  references              TutorReference[]
  offerings               TutorOffering[]

  @@index([status])
  @@index([institutionId])
  @@index([submittedAt])
}

// ============================================
// INSTITUTION (Multi-type academic institution)
// ============================================
model Institution {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  shortName       String?
  type            InstitutionType   @default(UNIVERSITY)
  description     String?
  country         String?           @default("Zambia")
  province        String?
  city            String?
  website         String?
  email           String?
  phone           String?
  logoUrl         String?
  levelType       LevelType         @default(YEAR)
  numLevels       Int               @default(4)
  periodType      PeriodType        @default(SEMESTER)
  numPeriods      Int               @default(2)
  hasFaculties    Boolean           @default(false)
  hasBranches     Boolean           @default(false)
  isActive        Boolean           @default(true)
  isVerified      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  levels          AcademicLevel[]
  periods         AcademicPeriod[]
  faculties       Faculty[]
  programmes      Programme[]
  users           User[]
  banners         Banner[]      @relation("BannerPrimaryInstitution")
  bannerTargets   BannerTarget[] @relation("BannerTargetInstitution")

  // Clerk Organization linkage
  clerkOrgId     String?   @unique
  clerkOrgSlug   String?

  // Tutor applications
  tutorApplications   TutorApplication[]
  applicationWindows  ApplicationWindow[]

  // Institution change requests
  changeRequestsCurrent InstitutionChangeRequest[] @relation("ChangeRequestCurrentInst")
  changeRequestsNew     InstitutionChangeRequest[] @relation("ChangeRequestNewInst")

  @@index([slug])
  @@index([type])
  @@index([isActive, isVerified])
  @@index([city])
}

// ============================================
// ACADEMIC LEVEL (e.g., "Year 1", "Stage 3")
// ============================================
model AcademicLevel {
  id              String    @id @default(cuid())
  name            String    // e.g. "Year 1", "Stage 3"
  order           Int       @default(0)
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses         Course[]
  createdAt       DateTime  @default(now())

  @@unique([institutionId, order])
  @@index([institutionId, order])
}

// ============================================
// ACADEMIC PERIOD (e.g., "Semester 1", "Term 2")
// ============================================
model AcademicPeriod {
  id              String    @id @default(cuid())
  name            String    // e.g. "Semester 1", "Term 2"
  order           Int       @default(0)
  academicYear    Int       @default(2025)
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses         Course[]
  createdAt       DateTime  @default(now())

  @@unique([institutionId, order, academicYear])
  @@index([institutionId, order])
}

// ============================================
// FACULTY (e.g., "Faculty of ICT")
// ============================================
model Faculty {
  id              String    @id @default(cuid())
  name            String    // e.g. "Faculty of Information Technology"
  code            String    // e.g. "ICT", "ENG"
  description     String?
  institutionId   String
  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programmes      Programme[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

// ============================================
// BANNERS (Admin announcements)
// ============================================
model Banner {
  id            String          @id @default(cuid())
  institutionId String?         // KEEP for backward compat (single target)
  institution   Institution?    @relation("BannerPrimaryInstitution", fields: [institutionId], references: [id], onDelete: SetNull)

  title         String
  message       String          @db.Text
  ctaLabel      String?
  ctaUrl        String?
  imageUrl      String?

  variant       BannerVariant   @default(INFO)
  placement     BannerPlacement @default(HOMEPAGE)

  scope         BannerScope     @default(SPECIFIC)
  targets       BannerTarget[]

  startsAt      DateTime        @default(now())
  endsAt        DateTime?
  isActive      Boolean         @default(true)
  priority      Int             @default(0)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([placement, isActive, startsAt, endsAt])
  @@index([institutionId])
  @@index([scope])
}

// ============================================
// BANNER TARGETS (Many-to-many: Banner ↔ Institution)
// ============================================
model BannerTarget {
  id            String       @id @default(cuid())
  bannerId      String
  banner        Banner       @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  institutionId String
  institution   Institution  @relation("BannerTargetInstitution", fields: [institutionId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())

  @@unique([bannerId, institutionId])
  @@index([institutionId])
}

// ============================================
// ORGANIZATION MEMBERSHIP (Clerk org membership tracking)
// ============================================
model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clerkOrgId     String
  clerkOrgSlug   String?
  role           String
  status         String   @default("active")
  joinedAt       DateTime @default(now())
  revokedAt      DateTime?

  @@unique([userId, clerkOrgId])
  @@index([clerkOrgId, status])
  @@index([userId])
}

// ============================================
// EXPLORATION LOG (Track cross-university browsing)
// ============================================
model ExplorationLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institutionId  String   // The institution being explored
  resourceType   String   // "UNIVERSITY" | "PROGRAMME" | "COURSE"
  resourceId     String
  action         String   @default("VIEW")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([institutionId])
}

// ============================================
// TUTOR REFERENCES
// ============================================
model TutorReference {
  id                  String   @id @default(cuid())
  tutorApplicationId  String
  tutorApplication    TutorApplication @relation(fields: [tutorApplicationId], references: [id], onDelete: Cascade)

  fullName            String
  relationship        String
  email               String
  phone               String?
  institution         String?

  createdAt           DateTime @default(now())

  @@index([tutorApplicationId])
}

// ============================================
// TUTOR COURSE OFFERINGS
// ============================================
model TutorOffering {
  id                  String   @id @default(cuid())
  tutorApplicationId  String
  tutorApplication    TutorApplication @relation(fields: [tutorApplicationId], references: [id], onDelete: Cascade)

  courseId            String?
  course              Course?  @relation(fields: [courseId], references: [id])

  title               String
  description         String   @db.Text
  level               String

  priceZMW            Int
  durationMinutes     Int      @default(60)
  maxStudentsPerSession Int    @default(1)

  modes               String[]
  schedule            Json?

  prerequisites       String?  @db.Text
  learningOutcomes    String[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tutorApplicationId])
  @@index([courseId])
}

// ============================================
// INSTITUTION CHANGE REQUEST (Student requests to change institution)
// ============================================
enum InstitutionChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

model InstitutionChangeRequest {
  id              String                    @id @default(cuid())
  userId          String
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current institution
  currentInstitutionId  String?
  currentInstitution    Institution?        @relation("ChangeRequestCurrentInst", fields: [currentInstitutionId], references: [id], onDelete: SetNull)
  currentProgrammeId    String?
  currentYear           Int?
  currentPeriod         String?

  // Requested new institution
  newInstitutionId      String?
  newInstitution        Institution?        @relation("ChangeRequestNewInst", fields: [newInstitutionId], references: [id], onDelete: SetNull)
  newProgrammeId        String?
  newProgramme          Programme?        @relation("ChangeRequestNewProg", fields: [newProgrammeId], references: [id], onDelete: SetNull)
  newYear               Int?
  newPeriod             String?

  reason                String?             @db.Text
  status                InstitutionChangeStatus @default(PENDING)
  adminNotes            String?             @db.Text
  reviewedBy            String?
  reviewedAt            DateTime?

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// APPLICATION WINDOWS (Admin control for opening/closing tutor applications)
// ============================================
model ApplicationWindow {
  id              String   @id @default(cuid())
  institutionId   String?
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  isOpen          Boolean  @default(false)
  opensAt         DateTime?
  closesAt        DateTime?
  publicMessage   String?  @db.Text
  notifiedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([institutionId, isOpen])
  @@index([opensAt, closesAt])
}
